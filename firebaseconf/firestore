rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == "joelvieira148@gmail.com";
    }

    function isCoralMaestro(coralId) {
      return signedIn()
        && coralId is string
        && exists(/databases/$(database)/documents/records/$(coralId))
        && get(/databases/$(database)/documents/records/$(coralId)).data.entity == "Coral"
        && get(/databases/$(database)/documents/records/$(coralId)).data.data.maestro_email == request.auth.token.email;
    }

    function isCoralOwnerRecord(recordData) {
      return signedIn()
        && recordData.entity == "Coral"
        && recordData.data.maestro_email == request.auth.token.email;
    }

    function isSelfMemberCreate(recordData) {
      return signedIn()
        && recordData.entity == "Membro"
        && recordData.data.cargo == "membro"
        && (
          recordData.data.user_email == request.auth.token.email
          || recordData.data.email == request.auth.token.email
        );
    }

    function canWriteCoralContent(recordData) {
      return isAdmin() || isCoralMaestro(recordData.data.coral_id);
    }

    function canCreateRecord(recordData) {
      return (
        !(recordData.entity in ["Coral", "Membro", "Musica", "Aviso", "Evento"])
        || (recordData.entity == "Coral" && (isAdmin() || isCoralOwnerRecord(recordData)))
        || (recordData.entity == "Membro" && (isSelfMemberCreate(recordData) || canWriteCoralContent(recordData)))
        || (recordData.entity in ["Musica", "Aviso", "Evento"] && canWriteCoralContent(recordData))
      );
    }

    function canUpdateOrDeleteRecord(recordData) {
      return (
        !(recordData.entity in ["Coral", "Membro", "Musica", "Aviso", "Evento"])
        || (recordData.entity == "Coral" && (isAdmin() || isCoralOwnerRecord(recordData)))
        || (recordData.entity == "Membro" && canWriteCoralContent(recordData))
        || (recordData.entity in ["Musica", "Aviso", "Evento"] && canWriteCoralContent(recordData))
      );
    }

    match /profiles/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /records/{recordId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.owner_id == request.auth.uid
        && canCreateRecord(request.resource.data);
      allow update, delete: if signedIn()
        && canUpdateOrDeleteRecord(resource.data);
    }
  }
}
